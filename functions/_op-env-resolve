# Resolve every exported op:// reference in the environment, in place: whole-value refs and {{ op://... }} tags.
# --if-changed: do nothing if the refs found are the ones the last pass failed on.
# Returns 1 if any reference is left unresolved.

emulate -L zsh -o extended_glob -o no_aliases
# no_xtrace keeps secrets out of `set -x` output.
setopt local_options no_xtrace no_verbose

# Prefixed so a local cannot shadow an exported variable of the same name.
local _oe_name _oe_ref _oe_value _oe_line _oe_sig _oe_abort _oe_tmp _oe_out _oe_err _oe_injecterr _oe_vault
local _oe_rest _oe_head _oe_lit
local -i _oe_st _oe_idx _oe_nested _oe_signed=0
# _oe_partsof: name -> NUL-joined (text ref text ref ... text). A whole-value ref is ('' ref '').
local -A _oe_valof _oe_partsof _oe_got _oe_why _oe_show
local -a _oe_failed _oe_shout _oe_acc _oe_lines _oe_vaults _oe_parts
local -aU _oe_cand _oe_refs

for _oe_name in ${(k)parameters[(R)scalar*export*]}; do
    [[ $_oe_name == [A-Za-z_][A-Za-z0-9_]# ]]     || continue
    [[ ${parameters[$_oe_name]} == *readonly* ]] && continue
    # A value this plugin set is a secret, not a ref, even if it holds op:// text.
    _op-env-candidate $_oe_name || continue
    _oe_value=${(P)_oe_name}
    _oe_parts=() _oe_lit='' _oe_rest=$_oe_value _oe_nested=0
    # op inject rejects a tag inside a tag; resolving just the inner one would leave a template that never resolves.
    while [[ $_oe_rest == *'{{'[[:blank:]]#op://* ]]; do
        _oe_rest=${_oe_rest#*'{{'[[:blank:]]#op://}
        [[ ${_oe_rest%%'}}'*} == *'{{'* ]] && { _oe_nested=1; break }
    done
    _oe_rest=$_oe_value
    # Innermost {{ }} pairs only; anything that is not a {{ op://... }} tag stays literal text.
    while (( ! _oe_nested )) && [[ $_oe_rest == *'}}'* ]]; do
        _oe_head=${_oe_rest%%'}}'*}
        _oe_rest=${_oe_rest#*'}}'}
        _oe_ref=${${${_oe_head##*'{{'}##[[:blank:]]#}%%[[:blank:]]#}
        if [[ $_oe_head == *'{{'* && $_oe_ref == op://?* ]]; then
            _oe_parts+=("$_oe_lit${_oe_head%'{{'*}" "$_oe_ref")
            _oe_lit=''
        else
            _oe_lit+="$_oe_head}}"
        fi
    done
    # The whole value stands in for the ref, so it fails and is reported like one, and never reaches op.
    if (( _oe_nested )); then
        _oe_parts=('' "$_oe_value" '')
        _oe_why[$_oe_value]='nested {{ }} tags are not supported (op inject rejects them too)'
        # The value can hold a secret, so the report names the variable only.
        _oe_show[$_oe_value]='(value not shown)'
    elif (( $#_oe_parts )); then
        _oe_parts+=("$_oe_lit$_oe_rest")
    elif [[ $_oe_value == op://?* ]]; then
        _oe_parts=('' "$_oe_value" '')
    else
        continue
    fi
    _oe_valof[$_oe_name]=$_oe_value
    _oe_partsof[$_oe_name]=${(pj:\0:)_oe_parts}
    (( _oe_nested )) && continue
    for (( _oe_idx = 2; _oe_idx < $#_oe_parts; _oe_idx += 2 )); do
        _oe_cand+=("$_oe_parts[_oe_idx]")
    done
done
for _oe_name in ${(ko)_oe_valof}; do
    _oe_sig+="$_oe_name=$_oe_valof[$_oe_name]"$'\0'
done
[[ $1 == --if-changed && $_oe_sig == $_OP_ENV_LAST_SIG ]] && return 0

if (( ! $#_oe_valof )); then
    _op-env-dbg "no exported op:// references in the environment"
    _OP_ENV_LAST_SIG=''
    return 0
fi
_op-env-dbg "found ${#_oe_valof} var(s) with refs: ${(ko)_oe_valof}"

_op-env-split-vaults _oe_vaults "${OP_ENV_VAULTS:-}"
for _oe_ref in $_oe_cand; do
    _oe_vault=${${_oe_ref#op://}%%/*}
    # op inject would read these as template syntax ("}}{{", bare refs on new lines, $VAR), smuggling refs past the vault checks.
    if [[ $_oe_ref == *[\{\}\$[:cntrl:]]* ]]; then
        _oe_why[$_oe_ref]='"{", "}", "$" and control characters are not allowed in a reference'
    # Checked before the cache, so narrowing either list also stops serving cached values.
    elif (( $#_OP_ENV_ALLOWED_VAULTS )) && (( ! ${_OP_ENV_ALLOWED_VAULTS[(Ie)$_oe_vault]} )); then
        _oe_why[$_oe_ref]="vault \"$_oe_vault\" is not in OP_ENV_ALLOWED_VAULTS"
    elif (( $#_oe_vaults )) && (( ! ${_oe_vaults[(Ie)$_oe_vault]} )); then
        _oe_why[$_oe_ref]="vault \"$_oe_vault\" is not in OP_ENV_VAULTS"
    elif [[ -z ${OP_ENV_NO_CACHE:-} ]] && (( $+_OP_ENV_CACHE[$_oe_ref] )); then
        _oe_got[$_oe_ref]=$_OP_ENV_CACHE[$_oe_ref]
    else
        _oe_refs+=($_oe_ref)
    fi
done
if (( $#_oe_refs )); then
    _op-env-dbg "to resolve: $_oe_refs"
else
    _op-env-dbg "nothing to ask op for: ${#_oe_got} ref(s) served from cache"
fi

if (( $#_oe_refs )); then
    if (( $+commands[op] )); then
        _oe_tmp=$(mktemp "${TMPDIR:-/tmp}/op-env.XXXXXX") || _oe_abort="cannot create a temp file in ${TMPDIR:-/tmp} (mktemp failed)"
    else
        _oe_abort='`op` not found in PATH'
    fi
    {
        # --- fast path: one `op inject` call for the whole batch --------------------

        if [[ -z $_oe_abort ]]; then
            # Random delimiter lines, not NAME=value, so values with "=", newlines or trailing blank lines survive.
            local _oe_nl=$'\n' _oe_sep="__op_env_sep_${RANDOM}${RANDOM}__" _oe_template=''
            for (( _oe_idx = 1; _oe_idx <= $#_oe_refs; _oe_idx++ )); do
                _oe_template+="${_oe_idx}${_oe_nl}{{ $_oe_refs[_oe_idx] }}${_oe_nl}${_oe_sep}${_oe_nl}"
            done

            _oe_out=$(print -rn -- $_oe_template | op inject 2>$_oe_tmp)
            _oe_st=$?
            _oe_injecterr=$(<$_oe_tmp)
            _op-env-dbg "op inject exited $_oe_st, ${#_oe_out} bytes out, ${#_oe_injecterr} bytes stderr"

            if (( _oe_st == 0 )); then
                # Line walk, not (s) split: (s) cannot split on a multi-line delimiter, and (@f) keeps empty lines.
                _oe_idx=0
                for _oe_line in "${(@f)_oe_out}"; do
                    if (( ! _oe_idx )); then
                        [[ $_oe_line == <1-> ]] && _oe_idx=$_oe_line
                        _oe_acc=()
                        continue
                    fi
                    if [[ $_oe_line == "$_oe_sep" ]]; then
                        _oe_value=${(pj:\n:)_oe_acc}
                        _oe_ref=$_oe_refs[_oe_idx]
                        _oe_idx=0
                        [[ -n $_oe_ref ]] || continue
                        # op passes unresolvable templates through; compare to this ref so a secret containing "op://" is kept.
                        if [[ $_oe_value == ('{{'*$_oe_ref*'}}'|$_oe_ref) ]]; then
                            _oe_why[$_oe_ref]='op inject left the template unresolved'
                            continue
                        fi
                        _oe_got[$_oe_ref]=$_oe_value
                        _op-env-dbg "  $_oe_ref <- ${#_oe_value} bytes via inject"
                        continue
                    fi
                    _oe_acc+=("$_oe_line")
                done
            elif (( _oe_st > 128 )); then
                _oe_abort="op inject interrupted (exit $_oe_st)"
            fi
        fi

        # --- slow path: whatever the batch did not produce -------------------------

        # One ref at a time, so a single bad ref cannot hold the rest hostage and the error names it.
        for _oe_ref in $_oe_refs; do
            (( $+_oe_got[$_oe_ref] )) && continue
            if [[ -n $_oe_abort ]]; then
                _oe_why[$_oe_ref]=$_oe_abort
                continue
            fi
            [[ -n ${_oe_why[$_oe_ref]:-} ]] || _oe_why[$_oe_ref]='missing from the op inject output'
            # Trailing x stops $(...) from stripping the secret's own trailing newlines.
            _oe_value=$(op read --no-newline -- $_oe_ref 2>$_oe_tmp && print -n x)
            _oe_st=$?
            if (( _oe_st == 0 )); then
                _oe_got[$_oe_ref]=${_oe_value%x}
                _op-env-dbg "  $_oe_ref <- ${#_oe_got[$_oe_ref]} bytes via op read (inject said: $_oe_why[$_oe_ref])"
                continue
            fi
            _oe_err=$(<$_oe_tmp)
            _oe_why[$_oe_ref]=${_oe_err:-$_oe_why[$_oe_ref]}
            _op-env-dbg "  $_oe_ref FAILED: $_oe_why[$_oe_ref]"
            # A bad ref leaves op signed in. Any other failure (signed out, prompt dismissed) would repeat, and re-prompt, for every ref.
            if (( _oe_st > 128 )); then
                _oe_abort="skipped after $_oe_ref failed: ${_oe_why[$_oe_ref]%%$'\n'*}"
            elif (( ! _oe_signed )); then
                if op whoami </dev/null >/dev/null 2>&1; then
                    _oe_signed=1
                else
                    _oe_abort="skipped after $_oe_ref failed: ${_oe_why[$_oe_ref]%%$'\n'*}"
                fi
            fi
        done
    } always {
        # Ctrl-C skips the rest of the function, but not this.
        [[ -n $_oe_tmp ]] && rm -f -- $_oe_tmp
    }
fi

# All or nothing per variable, and one pass over the parts, so a substituted secret is never read as a template.
for _oe_name in ${(ko)_oe_partsof}; do
    _oe_parts=("${(@ps:\0:)_oe_partsof[$_oe_name]}")
    _oe_value=$_oe_parts[1]
    for (( _oe_idx = 2; _oe_idx < $#_oe_parts; _oe_idx += 2 )); do
        _oe_ref=$_oe_parts[_oe_idx]
        if (( ! $+_oe_got[$_oe_ref] )); then
            _oe_failed+=($_oe_name)
            continue 2
        fi
        _oe_value+=$_oe_got[$_oe_ref]$_oe_parts[_oe_idx+1]
    done
    typeset -gx "$_oe_name=$_oe_value"
    _OP_ENV_RESOLVED[$_oe_name]=$_oe_value
done
for _oe_ref in ${(k)_oe_got}; do
    [[ -n ${OP_ENV_NO_CACHE:-} ]] || _OP_ENV_CACHE[$_oe_ref]=$_oe_got[$_oe_ref]
    unset "_OP_ENV_WARNED[$_oe_ref]"
done

_oe_sig=''
for _oe_name in ${(ko)_oe_valof}; do
    (( ${_oe_failed[(Ie)$_oe_name]} )) && _oe_sig+="$_oe_name=$_oe_valof[$_oe_name]"$'\0'
done
_OP_ENV_LAST_SIG=$_oe_sig

# Failed vars keep their op:// value: visibly unresolved beats silently empty. Each ref is reported once.
for _oe_name in $_oe_failed; do
    _oe_parts=("${(@ps:\0:)_oe_partsof[$_oe_name]}")
    for (( _oe_idx = 2; _oe_idx < $#_oe_parts; _oe_idx += 2 )); do
        _oe_ref=$_oe_parts[_oe_idx]
        if (( ! $+_oe_got[$_oe_ref] && ! $+_OP_ENV_WARNED[$_oe_ref] )); then
            _oe_shout+=($_oe_name)
            break
        fi
    done
done
if (( $#_oe_shout )); then
    print -ru2 -- "op-env: could not resolve ${(j:, :)_oe_shout} (left unchanged)"
    for _oe_name in $_oe_shout; do
        _oe_parts=("${(@ps:\0:)_oe_partsof[$_oe_name]}")
        for (( _oe_idx = 2; _oe_idx < $#_oe_parts; _oe_idx += 2 )); do
            _oe_ref=$_oe_parts[_oe_idx]
            (( $+_oe_got[$_oe_ref] )) && continue
            _OP_ENV_WARNED[$_oe_ref]=1
            print -ru2 -- "  $_oe_name  ${_oe_show[$_oe_ref]:-$_oe_ref}"
            print -ru2 -- "      ${${_oe_why[$_oe_ref]:-unknown}//$'\n'/ }"
        done
    done
    if [[ -n $_oe_injecterr ]]; then
        _oe_lines=("${(@f)_oe_injecterr}")
        print -ru2 -- "  op inject: ${(j:; :)_oe_lines[1,2]}"
    fi
    print -ru2 -- "  details: OP_ENV_DEBUG=1 op-env-resolve"
fi
(( ! $#_oe_failed ))
