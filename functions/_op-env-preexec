# preexec, not precmd: direnv's precmd has always run by now, whatever order the hooks were added in.
emulate -L zsh
# no_xtrace keeps the values checked below out of `set -x` output.
setopt local_options no_xtrace no_verbose

case ${OP_ENV_HOOK:-direnv} in
    off) return 0 ;;
    always) ;;
    *)
        if (( ${+_OP_ENV_LAST_DIFF} )) && [[ ${DIRENV_DIFF:-} == $_OP_ENV_LAST_DIFF ]]; then
            # Same diff can still mean refs are back: direnv unloaded and reloaded inside one command (cd .. && cd -).
            local _oe_name _oe_back=''
            for _oe_name in $_OP_ENV_RESOLVED; do
                [[ ${(P)_oe_name:-} == op://?* ]] && { _oe_back=1; break }
            done
            [[ -n $_oe_back ]] || return 0
        fi
        typeset -g _OP_ENV_LAST_DIFF=${DIRENV_DIFF:-} ;;
esac
_op-env-resolve --if-changed
return 0
